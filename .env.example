# Copy to .env and fill in. Never commit .env.

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Models per role (swap in seconds; each needs a row in the price table in backend/app/config.py
# or in PRICES_JSON below)
TRIAGE_MODEL=gpt-6-luna
PROFILE_MODEL=gpt-6.1-sol
INVESTIGATOR_MODEL=gpt-6.1-sol
CRITIC_MODEL=gpt-6.1-sol
DRAFTER_MODEL=gpt-6.1-sol
EMBEDDING_MODEL=text-embedding-3-small

# Reasoning effort per tier (gpt-6-luna: none|low|medium|high, gpt-6.1-sol: low|medium|high)
TRIAGE_REASONING=none
AGENT_REASONING=low

# Optional price override, USD per 1M tokens, e.g.
# PRICES_JSON={"my-model": {"input": 1.0, "cached_input": 0.1, "output": 4.0}}
PRICES_JSON=

# Startup model verification: strict (exit on bad key/model) | warn | off
MODEL_CHECK=strict

# --- Spending safety ----------------------------------------------------
GLOBAL_SPEND_CAP_USD=20
DEFAULT_RUN_BUDGET_USD=0.10
MAX_RUN_BUDGET_USD=0.50

# --- Web ----------------------------------------------------------------
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# true when served over HTTPS (production)
COOKIE_SECURE=false

# Caddy site address: your domain (sarenakh.example.com) or <ip-with-dashes>.sslip.io
SITE_ADDRESS=:80
