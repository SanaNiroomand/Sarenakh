# Copy to .env and fill in. Never commit .env.

# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Models per role (swap in seconds; each needs a row in the price table in backend/app/config.py
# or in PRICES_JSON below)
TRIAGE_MODEL=gpt-6-luna
PROFILE_MODEL=gpt-6.1-sol
INVESTIGATOR_MODEL=gpt-6.1-sol
CRITIC_MODEL=gpt-6.1-sol
DRAFTER_MODEL=gpt-6.1-sol
EMBEDDING_MODEL=text-embedding-3-small

# Reasoning effort per tier (gpt-6-luna: none|low|medium|high, gpt-6.1-sol: low|medium|high)
TRIAGE_REASONING=none
AGENT_REASONING=low

# Optional price override, USD per 1M tokens, e.g.
# PRICES_JSON={"my-model": {"input": 1.0, "cached_input": 0.1, "output": 4.0}}
PRICES_JSON=

# Startup model verification: strict (refuse to start on a bad key/model) | warn | off
# strict for the first deploy; warn during judging so the app always starts (sample replays keep
# working from the golden cache) while new paid runs are refused with a clear message.
MODEL_CHECK=strict

# --- Spending safety ----------------------------------------------------
GLOBAL_SPEND_CAP_USD=20
DEFAULT_RUN_BUDGET_USD=0.25
MAX_RUN_BUDGET_USD=1.00
# paid spend per user per 24h (profile chat + runs); sample replays are free and not counted
USER_DAILY_CAP_USD=1.50

# --- X (Twitter) search, optional ---------------------------------------
# Bearer token from console.x.com (pay-per-use: about $0.005 per post read, $0.01 per user).
# Set a spend limit in the X console too. Empty = the Twitter option is hidden.
X_BEARER_TOKEN=
X_MAX_POSTS=300
# reuse search results this many hours before asking X again (then only newer posts are fetched)
X_CACHE_HOURS=24

# --- Web ----------------------------------------------------------------
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# true when served over HTTPS (production)
COOKIE_SECURE=false

# Caddy site address: your domain (sarenakh.example.com) or <ip-with-dashes>.sslip.io
SITE_ADDRESS=:80
